# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://freeusdthub.com)
APP_URL="http://localhost:3000"

# DATABASE_URL: MySQL / MariaDB connection string for Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/free_usdt_hub"

# COINGECKO_API_KEY: Optional CoinGecko Demo or Pro API Key for higher rate limits
# Stored strictly server-side. Never exposed to browser or client JavaScript.
COINGECKO_API_KEY="replace_with_real_key"

# MONETAG_VERIFICATION_TAG: Publisher verification token for Monetag ad network
MONETAG_VERIFICATION_TAG="6403520c5cf5d7c84f05b9b0223f05c7"

# PORT: Server listening port
PORT=3000
